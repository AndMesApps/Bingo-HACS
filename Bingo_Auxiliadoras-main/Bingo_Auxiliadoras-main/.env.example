# Base de datos: cadena "Transaction pooler" de Supabase (Connect → puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-xx.pooler.supabase.com:6543/postgres

# Clave de acceso al panel /admin.html (una frase larga)
ADMIN_PASSWORD=

# Comprobantes de pago: Vercel Blob privado (lo crea Vercel al conectar la tienda Blob)
BLOB_READ_WRITE_TOKEN=

# Imágenes de las tablas: bucket privado "tablas" en Supabase Storage
SUPABASE_URL=https://jxyyawnqmsxxirdbdryh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=tablas

# Código de país para completar celulares que empiezan en 0 (57 Colombia, 58 Venezuela)
CODIGO_PAIS=57

# Dirección pública del sitio (opcional; si falta se toma de la petición)
# APP_URL=https://tu-proyecto.vercel.app

# Correo (Resend). Sin estas variables el panel ofrece un enlace mailto para enviar a mano.
RESEND_API_KEY=
EMAIL_FROM=Bingo HACS <bingo@tu-dominio.org>

# WhatsApp Cloud API (opcional). Sin ellas el panel ofrece un enlace wa.me para enviar a mano.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=
